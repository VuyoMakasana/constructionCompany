# ====== Copy this file to .env (local) and add the same values in Vercel > Settings > Environment Variables ======
# Never commit .env. Never put these values in the client folder.

# --- Server (local only; Vercel sets its own port) ---
PORT=4000
# Local development address of the website. In production the site and API share one address, so this is not needed.
CLIENT_URL=http://localhost:5173

# --- Company ---
COMPANY_NAME=Your Company Name
# Inbox that receives new enquiries and quotation requests
COMPANY_EMAIL=

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER
MAIL_FROM=

# --- Database (optional). Supabase works. See README. Leave empty to email only. ---
# Vercel: use the Supabase "Transaction pooler" string and add ?pgbouncer=true&connection_limit=1
DATABASE_URL=

# --- Website address, used for sitemap.xml at build time (Vercel build setting) ---
SITE_URL=
